module ip_ram (
  clk42m,
  w_ram_cs,
  w_re,
  n24_6,
  w_we,
  w_bus_ctrl_address,
  w_bus_ctrl_wdata,
  w_ram_q
)
;
input clk42m;
input w_ram_cs;
input w_re;
input n24_6;
input w_we;
input [10:0] w_bus_ctrl_address;
input [7:0] w_bus_ctrl_wdata;
output [7:0] w_ram_q;
wire [31:8] DO;
wire VCC;
wire GND;
  SP u_ram_s31 (
    .DO({DO[31:8],w_ram_q[7:0]}),
    .CLK(clk42m),
