input [7:0] w_bus_wdata;
output w_bus_bootrom_rdata_en;
output ff_is_ram;
output [7:0] w_ram_q;
output [7:0] w_rom_q;
wire n34_3;
wire w_ram_cs;
wire w_re;
wire w_we;
wire n24_6;
wire w_ram_cs_10;
wire VCC;
wire GND;
  LUT2 n34_s0 (
    .F(n34_3),
    .I0(w_bus_valid_Z),
    .I1(w_bus_bootrom_cs) 
