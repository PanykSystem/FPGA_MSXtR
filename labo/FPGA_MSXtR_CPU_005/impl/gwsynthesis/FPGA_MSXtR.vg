  n144_4,
  n2037_9,
  n568_5,
  w_s2026_cs_5,
  n426_4,
  w_bus_address,
  w_bus_wdata,
  w_bus_bootrom_rdata_en,
  ff_is_ram,
  w_ram_q,
  w_rom_q
)
;
input clk42m;
input w_bus_write_Z;
input w_bus_bootrom_cs;
input w_bus_valid_Z;
input ff_bootrom_reset_n;
input n12_4;
input w_uart_cs_4;
