module Gowin_SP (
  w_we,
  clk42m,
  w_ram_cs,
  w_re,
  n24_6,
  w_bus_wdata,
  w_bus_address,
  w_ram_q
)
;
input w_we;
input clk42m;
input w_ram_cs;
input w_re;
input n24_6;
input [7:0] w_bus_wdata;
input [9:0] w_bus_address;
output [7:0] w_ram_q;
wire [31:8] DO;
wire VCC;
wire GND;
  SP sp_inst_0 (
    .DO({DO[31:8],w_ram_q[7:0]}),
    .DI({GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,w_bus_wdata[7:0]}),
    .BLKSEL({GND,GND,GND}),
    .AD({w_bus_address[9:0],GND,GND,GND,GND}),
    .WRE(w_we),
    .CLK(clk42m),
    .CE(w_ram_cs),
    .OCE(w_re),
    .RESET(n24_6) 
);
defparam sp_inst_0.BIT_WIDTH=8;
defparam sp_inst_0.BLK_SEL=3'b000;
defparam sp_inst_0.READ_MODE=1'b1;
defparam sp_inst_0.RESET_MODE="SYNC";
defparam sp_inst_0.WRITE_MODE=2'b00;
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
endmodule /* Gowin_SP */
module bootrom (
  clk42m,
  w_bus_write_Z,
  w_bus_bootrom_cs,
